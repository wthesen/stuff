def _add_fluid_or_surface_object(model, model_component: str, name: str=None, parameters: Dict[str, object]={}):
    """ """
    if not model.is_open:
        raise ValueError('The model has been closed.')
    if not model_component in SURFACE_MODEL_COMPONENTS and \
        not model_component in FLUID_MODEL_COMPONENTS:
        raise ValueError("{} is not a surface equipment or a fluid".format(model_component))

    class_info = lookup_class_information_for_model_component(model_component)
    if name is None:
        name = _generate_unique_name(model, model_component)

    if not _is_name_unique(model, model_component, name):
        raise ValueError('The name {} already exists in the model.'.format(name))

    if model_component is ModelComponents.PVTFLUID:
        pvt_fluid = model.find(component=ModelComponents.PVTFLUID)
        if pvt_fluid is not None and len(pvt_fluid) > 0:
            raise ValueError('A PVTFluid {} already exists in the model.'.format(pvt_fluid[0]))

    node = _add_by_class_info(model, class_info, name, parameters)
    _set_node_parameters(model, node, parameters)

    if class_info.class_id == ModelClasses.PUMP or class_info.class_id == ModelClasses.COMPRESSOR:
        _load_catalog_data(model, node, parameters)

    return node


def _add_study_or_sim_task_object(model, model_component: str, name: str=None, context: str=None, parameters: Dict[str, object]={}):

    if name is None:
        name = _generate_unique_name(model, model_component)

    if model_component == ModelComponents.STUDY and not _is_name_unique(model, model_component, name):
        raise ValueError('The name {} already exists in the model.'.format(name))

    if model_component == ModelComponents.STUDY:
        class_info = lookup_class_information_for_model_component(model_component)

        node = _add_by_class_info(model, class_info, name, parameters)
        _set_node_parameters(model, node, parameters)
        return node

    #sim operations need special handling
    if model_component == ModelComponents.NETWORKSIMULATION:
        study =_get_study_catalog_entry(context, model._catalog)
        return _create_net_sim_task(model, name, study.node_id, study.name, parameters)

    if model_component == ModelComponents.NETWORKOPTIMIZERSIMULATION:
        study =_get_study_catalog_entry(context, model._catalog)
        return _create_net_opt_sim_task(model, name, study.node_id, study.name, parameters)

    if model_component == ModelComponents.PTPROFILESIMULATION:
        study = _get_study_entry(model, context)
        return _create_pt_sim_task(model, name, study.node_id, study.name, parameters)

    if model_component == ModelComponents.SYSTEMANALYSISOPERATION:
        study = _get_study_catalog_entry(context, model._catalog)
        return _create_sa_sim_task(model, name, study.node_id, study.name, parameters)

    if model_component == ModelComponents.WELLPERFORMANCECURVESOPERATION:
        study = _get_study_catalog_entry(context, model._catalog)
        return _create_wc_sim_task(model, name, study.node_id, study.name, parameters)

    if model_component == ModelComponents.GLDIAGNOSTICSOPERATION:
        study = _get_study_catalog_entry(context, model._catalog)
        return _create_gldiagnostics_sim_task(model, name, study.node_id, study.name, parameters)


    raise ValueError('The type of the task {} is not supported.'.format(model_component))

def _get_study_catalog_entry(name, catalog):
    studies = catalog.lookup_entries_by_class_ids([ModelClasses.STUDY])
    if name:
        studies = [study for study in studies if study.name == name]
        if not studies:
            raise ValueError( "Study {} does not exist. Create the study first.".format(name))
    elif not studies:
        raise RuntimeError( "No study exist in the model. Create a study first.")
    elif len(studies) > 1:
        raise RuntimeError( "Multiple studies exist in the model. Please specify a study.")

    return studies[0]

def _get_study_entry(model, context):
    study_name = None
    study_id = None
    model_context = None
    if not context:
        studies = model.find_components(component=ModelComponents.STUDY)
        if len(studies) == 0:
            raise ValueError('no study exists in the model. please create a study first')
        if len(studies) > 1:
            raise ValueError('There are multiple studies exist in the model. please specify a study in context parameter.')
        model_context = studies[0]

    merged_context = compute_context(root_context=model.context,
                                     context = context, component=ModelComponents.STUDY, model_context=model_context)

    studies = model._catalog.lookup_entries_by_context(merged_context, component=ModelComponents.STUDY)
    if len(studies) == 0:
        raise ValueError('no study {} exists in the model'.format(context))
    if len(studies) > 1:
        raise ValueError('There are multiple studies {} exist in the model. please correct the model.'.format(context))
    return studies[0]

def _create_net_sim_task(model, name, study_id, study_name, parameters):
    from sixgill.core.get_or_create_operation import get_or_create_network_sim_node
    net_sim = get_or_create_network_sim_node(model, study_name)
    if parameters:
        parameters[Parameters.NetworkSimulation.TASKNAME] = name
    else:
        parameters = {Parameters.NetworkSimulation.TASKNAME:name}
    _set_node_parameters(model, net_sim, parameters)
    return net_sim

def _create_net_opt_sim_task(model, name, study_id, study_name, parameters):
    from sixgill.core.get_or_create_operation import get_or_create_network_opt_sim_node
    net_sim = get_or_create_network_opt_sim_node(model, study_name)
    if parameters:
        parameters[Parameters.NetworkOptimizerSimulation.TASKNAME] = name
    else:
        parameters = {Parameters.NetworkOptimizerSimulation.TASKNAME:name}

    for parameter, value in parameters.items():
        model.set_node_value(net_sim, parameter=parameter, value=value)

    return net_sim



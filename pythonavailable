def _checkCasingSection(casingSections, top_measured_depth, length, casingType):
    if is_Nan_or_None(top_measured_depth, length):
        return (False, "Casing requires both top_measured_depth and length input parameters")
    #TODO: check if a casing can be added at the given depths
    return (True, None)

def _checkTubingSection(tubingSections, top_measured_depth, length):
    if is_Nan_or_None(top_measured_depth, length):
        return (False, "Tubing requires both top_measured_depth and length input parameters")
    #TODO: check if a tubing can be added at the given depths
    return (True, None)

def _find_tubing_section_at_depth(tubing_sections, md):
    for ts in tubing_sections:
        if is_lessthan_or_equal(ts.TopMeasuredDepth, md) and \
           is_greaterthan_or_equal(ts.TopMeasuredDepth + ts.Length, md):
            return ts
    return None

def _find_tubing_section_at_top_bottom_depth(tubing_sections, top_md, bottom_md):
    for ts in tubing_sections:
        if ts.TopMeasuredDepth <= top_md and ts.TopMeasuredDepth + ts.Length >= bottom_md:
            return ts
    return None

def _check_welltype_isadvanced(tubing_string):

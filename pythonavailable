def _generate_unique_name(model, model_component, well = None):
    name = model_component + "_" + str(randint(1, 1000))
    while not _is_name_unique(model, model_component, name, well):
        name = model_component + "_" + str(randint(1, 1000))
    return name

def _load_catalog_data(model, node, parameters):
    if parameters and Parameters.SharedPumpCatalogParameters.MANUFACTURER in parameters and \
       Parameters.SharedPumpCatalogParameters.MODEL in parameters:
        try:
            _load_pump_catalog_internal(model, node,None)
        except PipesimServerError as ex:
            raise ValueError("Cannot load the catalog data for manufacturer {manufacturer} and model {model}".format(
                           manufacturer = parameters[Parameters.SharedPumpCatalogParameters.MANUFACTURER],
                           model = parameters[Parameters.SharedPumpCatalogParameters.MODEL]))


def _load_pump_catalog(model, model_context : ModelContext):
    nodeCatalog = model._catalog.filter(model_context)
    for entry in nodeCatalog.all_entries:
        if not entry.class_id in EQUIPMENT_WITH_CATALOG:
            continue

        node = entry.get_node()
        loadFromCatalog = getattr(node, "_LoadFromCatalog", None)
        if loadFromCatalog:
            try:
                _load_pump_catalog_internal(model, node, entry)
            except PipesimServerError as ex:
                raise ValueError("Cannot load data from catalog due to the following error: {}".format(ex.get_error_message()))

def _load_pump_catalog_internal(model, node, entry):
    node._LoadFromCatalog.post_loadfromcataloglink()
    # we have to refresh the object factory cache for the node as
    # manta does not know the changes we make on that node
    model._session.object_factory._refresh(node)

    if entry and entry.class_id == ModelClasses.FLOWCONTROLVALVE:
        _fix_related_node_for_fcv(model, node)

def _fix_related_node_for_fcv(model, node):
    model._session.object_factory._refresh(node.ValveCatalogData)
    newNodes = []
    query = Query(model._session)
    parentFilter = defaultdict(dict)
    parentFilter["ValveCatalogData/@id"] = _get_link_id(node.ValveCatalogData.id)
    valve_coeffcients = query.filter(cls_type=model.api.ValveCoefficient.cls_type_id, **parentFilter).fetch()
    newNodes.extend(valve_coeffcients.members)
    model._catalog.add_entries_for_nodes(newNodes)


def _add_by_class_info(model, class_info: ModelComponentClassInfo, name: str, parameters={}):
    """ """
    newNodes = []
    class_id = class_info.class_id
    node = _add_new_node(model, class_info, name)
    newNodes.append(node)

    if class_id in POINT_SURFACE_EQUIPMENT:
        locationNode = _add_surface_location_node(model)
        node.Location = locationNode
        newNodes.append(locationNode)
        networkViewNode = _get_network_view_node(model._catalog)
        itemViewNode = _add_new_node(model, ModelComponentClassInfo(class_id=ModelClasses.ITEMVIEW,
                                                                    discriminant_property=None,
                                                                    discriminant_value=None))
        itemViewNode.AssociatedNode = node
        itemViewNode.NetworkView = networkViewNode
        newNodes.append(itemViewNode)


    if class_id == ModelClasses.BLACKOILFLUID:
        #Add calibration data
        singlePointCalibration = _add_new_node(model,
                                               ModelComponentClassInfo(class_id=ModelClasses.SINGLEPOINTCALIBRATION,
                                                                       discriminant_property=None,
                                                                       discriminant_value=None),
                                               name=None)
        node.CalibrationData = singlePointCalibration
        newNodes.append(singlePointCalibration)
        thermalData = _add_new_node(model,
                                    ModelComponentClassInfo(class_id=ModelClasses.BLACKOILTHERMALDATA,
                                                            discriminant_property=None,
                                                            discriminant_value=None),
                                    name=None)
        node.ThermalData = thermalData
        newNodes.append(thermalData)
        emulsionData = _add_new_node(model,
                                     ModelComponentClassInfo(class_id=ModelClasses.EMULSIONCOLLECTION,
                                                             discriminant_property=None,
                                                             discriminant_value=None),
                                     name=None)
        node.EmulsionData = emulsionData
        newNodes.append(emulsionData)
    elif class_id == ModelClasses.FLUIDCOMPONENT:
        isUserDefined = True
        flashPackage = model.fluids.compositional.pvt_package
        if flashPackage == Constants.PVTPackage.E300 and name in E300_COMPONENT_DICT:
            isUserDefined = False
        elif flashPackage == Constants.PVTPackage.GERG and name in GERG_COMPONENT_DICT:
            isUserDefined = False
        elif flashPackage == Constants.PVTPackage.MULTIFLASH and name in MULTIFLASH_COMPONENT_DICT:
            isUserDefined = False
        node.IsUserDefined = isUserDefined
        node.IsActive = True
        node.Model = _get_web_api_model(model._catalog)
    elif class_id == ModelClasses.COMPOSITIONALFLUID:
        node.Model = _get_web_api_model(model._catalog)
    elif class_id == ModelClasses.MFLFLUID:
        node.Model = _get_web_api_model(model._catalog)
    elif class_id == ModelClasses.PVTFLUID:
        node.Model = _get_web_api_model(model._catalog)
    elif class_id == ModelClasses.WELL:
        node.WellOutletEquipment = node
        subNodes = _get_new_borehole_and_well_strings(model._session, _get_link_id(node.id))
        subNodes.append(subNodes[0].Trajectory)
        newNodes.extend(subNodes)
    elif class_id == ModelClasses.FLOWLINE:
        pipe = node.Section
        pipeHeatTransfer = node.Section.HeatTransfer
        newNodes.extend([pipe, pipeHeatTransfer])
    elif class_id == ModelClasses.FLOWCONTROLVALVE:
        catalogData = _add_new_node(model,
                                    ModelComponentClassInfo(class_id=ModelClasses.VALVECATALOGDATA,
                                                             discriminant_property=None,
                                                             discriminant_value=None),
                                    name=None)
        node.CatalogData = catalogData
        newNodes.append(catalogData)
    elif class_id == ModelClasses.PUMP:
        catalogData = _add_new_node(model,
                                    ModelComponentClassInfo(class_id=ModelClasses.PUMPCATALOGDATA,
                                                             discriminant_property=None,
                                                             discriminant_value=None),
                                    name=None)
        node.CatalogData = catalogData
        newNodes.append(catalogData)
    elif class_id == ModelClasses.FLOWCORRELATION:
        newNodes.append(node.HorizontalFlowCorrelation)
        newNodes.append(node.SinglePhaseFlowCorrelation)
        newNodes.append(node.VerticalFlowCorrelation)

    elif class_id == ModelClasses.COMPRESSOR:
        catalogDataClass = ModelClasses.COMPRESSORCATALOGDATA
        if Parameters.Compressor.ISRECIPROCATING in parameters and parameters[Parameters.Compressor.ISRECIPROCATING]:
            catalogDataClass = ModelClasses.RECIPROCATINGCOMPRESSORCATALOGDATA
        catalogData = _add_new_node(model,
                                    ModelComponentClassInfo(class_id=catalogDataClass,
                                                             discriminant_property=None,
                                                             discriminant_value=None),
                                    name=None)
        node.CatalogData = catalogData
        newNodes.append(catalogData)

    _update_catalog(model, newNodes)

    return node

def _add_new_node(model: 'Model', class_info: ModelComponentClassInfo, name=None) -> object:
    payload = {
                SchemaNodes.TYPE: class_info.class_id,
              }

    if name:
        payload[SchemaNodes.NAME] = name

    if class_info.discriminant_property:
        payload[class_info.discriminant_property] = class_info.discriminant_value

    newNode = model._session.web_api.Node.post_node(payload)

    return newNode

def _set_node_parameters(model: 'Model', node: object, parameters: Optional[Dict[str, object]]) -> None:
    """Set the specified parameters on the node via the model's set_value() method.
    :param model: The model where the
    :param node:
    :param parameters:
    """
    if not parameters:
        return

    context = model._catalog.lookup_context_by_node(node)

    if Parameters.Completion.IPRMODEL in parameters:
        # Special case: we always want to set the IPR model *first*
        model.set_value(parameter=Parameters.Completion.IPRMODEL,
                        value=parameters[Parameters.Completion.IPRMODEL],
                        **context)

    if Parameters.MultiphaseBooster.TYPE in parameters:
        # Special case: we always want to set the Booster Type *first*
        model.set_value(parameter=Parameters.MultiphaseBooster.TYPE,
                        value=parameters[Parameters.MultiphaseBooster.TYPE],
                        **context)

    if Parameters.Junction.TREATASSOURCE in parameters:
        # Special case: we always want to set TREATASSOURCE *first*
        model.set_value(parameter=Parameters.Junction.TREATASSOURCE,
                        value=parameters[Parameters.Junction.TREATASSOURCE],
                        **context)

    # Now set all the other parameters...
    for parameter, value in parameters.items():
        if (parameter != Parameters.Completion.IPRMODEL and parameters != Parameters.MultiphaseBooster.TYPE
            and parameter != Parameters.Junction.TREATASSOURCE):
            model.set_value(parameter=parameter, value=value, **context)

def _copy(context, new_name, model, catalog, session, use_template_well=False):

    if model.find(Well=new_name):
        raise ValueError("Well with name '{}' already exist in the model.".format(new_name))

    if use_template_well:
        context.pop(SyntheticContextElements.TEMPLATE)

    if not context:
        raise ContextError("No well with name '{}' exists in the model.".format(new_name))

    node_id = get_node_id(catalog, context, ModelComponents.WELL)
    search_results = []
    search_results = _get_seach_results(node_id, session)

    types_of_node_to_not_be_copied = {'metadata#BlackOilFluid_2017.1',
                                      'metadata#BlackOilThermalData_2017.1',
                                      'metadata#EmulsionCollection_2017.1',
                                      'metadata#CompositionalFluid_2017.1',
                                      'metadata#FluidComponentFraction_2017.1',
                                      'metadata#FluidComponent_2017.1'}

    for index, node in enumerate(search_results):
        if node['@type'] in types_of_node_to_not_be_copied:
            search_results.pop(index)
        elif node['@type'] == 'metadata#WellHead_2017.1':
            node['Name'] = new_name

    payload = {'WithCreationReport': True}
    payload['Template'] = search_results
    template_response = session.web_api.Template.post_template(payload)
    newNodes = []
    itemViewNode = _add_new_node(model, ModelComponentClassInfo(class_id=ModelClasses.ITEMVIEW,
                                                                    discriminant_property=None,
                                                                    discriminant_value=None))
    networkViewNode = _get_network_view_node(model._catalog)
    itemViewNode.NetworkView = networkViewNode

    for template_response_item in template_response.CreatedNodes:
        created_node = template_response_item.CreatedNode
        #if _get_link_id(created_node.type_id) in types_of_node_not_to_be_added_to_context:
        #    continue
        if hasattr(created_node,'Name') and created_node.Name == new_name:
            itemViewNode.AssociatedNode = created_node
        newNodes.append(created_node)
    newNodes.append(itemViewNode)
    _update_catalog(model, newNodes)


def _get_seach_results(node_id, session):
    query = session.web_api.SearchInput()
    tmp = session.web_api.SearchWhereInput()
    tmp.Property = '/' + SchemaNodes.ID
    tmp.In = []
    tmp.In.append(node_id)
    query.Where = [tmp]
    query.Select = ['/*']
    query.RelatedNodes = session.web_api.RelatedNodesInput(Algorithm='AllRelated')

    # Perform the search:
    search_results = session.web_api.Search.post_search(query, raw_output=True)

    #search_results = json.dumps()
    #search_results = json.loads(search_results)
    ##Probably changing it to use manta objects, will wait to see what to do
    #search_results = str(search_results).replace('\'', '\"').replace('False', 'false').replace('True', 'true')
    return search_results[SchemaNodes.MEMBERS]

def get_node_id(catalog, context, model_component):
    filtered_catalog = catalog.filter(context)

    node_type = lookup_class_id_for_model_component(model_component, True).replace('#', '%23')

    node_id = None

    for id in filtered_catalog.all_node_ids:
        if node_type not in id:
            continue
        elif node_id:
            #print('more than one node with context id ' + node_id + ' ' + id)
            #FIXME: Should we be just continuing here?
            continue
        node_id = id
    return node_id

def _get_link_id(id):
    return id.split("/api/")[-1]

def _update_catalog(model, newNodes):
    model._catalog.add_entries_for_nodes(newNodes)

def _get_network_view_node(catalog):
    network_view_entry = catalog.lookup_entries_by_class_ids([ModelClasses.NETWORKVIEW])[0]
    return catalog.get_node_by_id(network_view_entry.node_id)

def _get_web_api_model(catalog):
    model_entries = catalog.lookup_entries_by_class_ids([ModelClasses.MODEL])
    if not model_entries:
        raise ValueError( "Web API model is not retrieved properly.")
    return catalog.get_node_by_id(model_entries[0].node_id)

def _cleanup_pt_sim_sensitivity_values(session, sens_var_id):
    query = Query(session)
    sens_var_parameters = {"Variable/@id": sens_var_id}
    result = query.filter(cls_type=ModelClasses.DOUBLEVALUE, **sens_var_parameters).fetch()
    for v in result.members:
        session.web_api.Node.delete_node(params=get_link_params(sens_var_id))


def _get_new_borehole_and_well_strings(session, well_id):
    """Get the newly created borehole and well strings that haven't been added to the catalog"""
    query = Query(session)
    well_parameters = {"WellHead/@id": well_id}
    result = query.filter(cls_type=ModelClasses.BOREHOLE, **well_parameters).fetch()
    borehole = result.members[0]

    casing_string = None
    tubing_string = None
    borehole_parameters = {"Borehole/@id": _get_link_id(borehole.id)}
    result = query.filter(cls_type=ModelClasses.WELLSTRING, **borehole_parameters).fetch()
    for ws in result.members:
        if ws.Name == "Casing 1":   #TODO: there should be a better way!
            casing_string = ws
        elif ws.Name == "Tubing":   #TODO: there should be a better way!
            tubing_string = ws

    return [borehole, casing_string, tubing_string]


def _get_borehole_and_well_strings(catalog, well_id):
    borehole_entry = catalog.lookup_entries_by_parent_id_and_class_id(well_id, ModelClasses.BOREHOLE)[0]
    borehole = catalog.get_node_by_id(borehole_entry.node_id)
    well_strings = [entry.get_node() for entry in catalog.lookup_entries_by_parent_id_and_class_id(borehole_entry.node_id, ModelClasses.WELLSTRING)]
    for ws in well_strings:
        if ws.Name == "Casing 1":   #TODO: there should be a better way!
            casing_string = ws
        elif ws.Name == "Tubing":   #TODO: there should be a better way!
            tubing_string = ws

    return [borehole, casing_string, tubing_string]


def _is_name_unique(model: 'Model', model_component: str, name: str, well=None) -> bool:
    if well:
        ctx = {SchemaNodes.NAME: name, ModelComponents.WELL: well}
    elif model_component == ModelComponents.STUDY:
        ctx = {ModelComponents.STUDY: name, ModelComponents.WELL: NONE}
    else:
        ctx = {SchemaNodes.NAME: name, ModelComponents.WELL: NONE}

    merged_context = compute_context(root_context=model.context,
                                     context_keywords=ctx)

    _logger.debug("_is_name_unique: merged context = {}".format(str(merged_context)))
    return not model._catalog.are_any_entries_in_context(merged_context)


def _add(model, component, name, context=None, parameters={}):

    if component in TASK_MODEL_COMPONENTS:
        #Study or operations
        newNode = _add_study_or_sim_task_object(model, component, name, context, parameters)
        return

    class_type_id = lookup_class_id_for_model_component(component, False)
    if(class_type_id is None):
        raise ValueError( "Cannot find class type id for {}".format(component))

    #surface equipment or fluids
    well_entries = []
    if context:    #for now, context is only used as well for downhole objects
        well_entries = [x for x in model._catalog.lookup_entries_by_class_ids([ModelClasses.WELL]) if x.name == context]
        if len(well_entries) == 0:
            raise ContextError("Well {} does not exist in the model".format(context))

    if len(well_entries) == 0:
        #surface equipment or fluids
        newNode = _add_fluid_or_surface_object(model, component, name, parameters)
        return

    #downhole objects
    if not component in DOWNHOLE_MODEL_COMPONENTS:
        raise ValueError( "{} is not a downhole component.".format(component))

    if not parameters or \
       not Parameters.DownholeLocation.TOPMEASUREDDEPTH in parameters or \
       is_undefined(parameters[Parameters.DownholeLocation.TOPMEASUREDDEPTH]):
        raise ValueError( "Adding downhole objects requires TopMeasuredDepth input parameter. Please specify it in parameters dictionary." )

    top_measured_depth = parameters[Parameters.DownholeLocation.TOPMEASUREDDEPTH]

    #downhole equipment
    well_ids = [w.node_id for w in well_entries]

    if len(well_ids) == 0:
        raise ValueError("well {} does not exist in the model".format(context))

    #print (well_ids)
    if len(well_ids) > 1:
        raise ValueError("multiple wells with name {} exist in the model".format(context))

    subNodes = _get_borehole_and_well_strings(model._catalog, well_ids[0])
    borehole = subNodes[0]
    casing_string = subNodes[1]
    tubing_string = subNodes[2]

    tubingSections = [entry.get_node()
                      for entry in model._catalog.lookup_entries_by_parent_id_and_class_id(_get_link_id(tubing_string.id), ModelClasses.TUBING)]
    casingSections = [entry.get_node()
                      for entry in model._catalog.lookup_entries_by_parent_id_and_class_id(_get_link_id(casing_string.id), ModelClasses.TUBING)]

    if name is None:
        name = _generate_unique_name(model, component, context)

    if not _is_name_unique(model, component, name, context):
        raise ValueError('The name {} already exists under well {}.'.format(name, context))

    class_info = lookup_class_information_for_model_component(component, True)
    new_nodes = []

    if (component == ModelComponents.CASING) or\
       (component == ModelComponents.LINER) or\
       (component == ModelComponents.OPEN_HOLE):

        if not Parameters.AbstractTubingSection.LENGTH in parameters or is_undefined(parameters[Parameters.AbstractTubingSection.LENGTH]):
            raise ValueError( "Casing section requires both TopMeasuredDepth and Length input parameters. Please specify them in parameters dictionary.")

        length = parameters[Parameters.AbstractTubingSection.LENGTH]
        # check if this casing section can be added or not
        (isOkToAdd, message) = _checkCasingSection(casingSections, top_measured_depth, length, class_info.discriminant_value)
        if not isOkToAdd:
           raise ValueError(message)

        node = _add_new_node(model, class_info, name)
        node.TopMeasuredDepth = top_measured_depth
        node.Length = length
        node.WellString = casing_string
        new_nodes.append(node)

        # CementTop value should be removed
        if component == ModelComponents.LINER or component == ModelComponents.OPEN_HOLE:
            node.CementTop = NAN

    elif component == ModelComponents.TUBING:
        if not Parameters.AbstractTubingSection.LENGTH in parameters or is_undefined(parameters[Parameters.AbstractTubingSection.LENGTH]):
            raise ValueError( "Tubing section requires both TopMeasuredDepth and Length input parameters. Please specify them in parameters dictionary.")
        #check if this tubing section can be added or not
        length = parameters[Parameters.AbstractTubingSection.LENGTH]
        (isOkToAdd, message) = _checkTubingSection(tubingSections, top_measured_depth, length)
        if not isOkToAdd:
            raise ValueError(message)

        node = _add_new_node(model, class_info, name)
        node.TopMeasuredDepth = top_measured_depth
        node.Length = length
        node.WellString = tubing_string
        new_nodes.append(node)

    # other downhole node. only packer and completion can associate with casing, others are all associated with tubing
    elif component == ModelComponents.PACKER:
        #find the casing section at the given depth to attach the equipment
        casingSection = _find_tubing_section_at_depth(casingSections, top_measured_depth)
        if casingSection is None:
            raise ValueError("Could not find a casing to add the packer. Add a casing at depth {}".format(top_measured_depth))
        node = _add_new_node(model, class_info, name)
        node.WellString = casing_string
        locationNode = _add_downhole_location_node(model)
        locationNode.TopMeasuredDepth = top_measured_depth
        node.Location = locationNode
        new_nodes.extend([node, locationNode])

    elif component == ModelComponents.COMPLETION:
        casingSection = None
        isDistributedCompletion = Parameters.Completion.FLUIDENTRYTYPE in parameters and \
                                 parameters[Parameters.Completion.FLUIDENTRYTYPE] == Constants.CompletionFluidEntry.DISTRIBUTED
        if isDistributedCompletion:
            if not Parameters.DownholeLocation.BOTTOMMEASUREDDEPTH in parameters or is_undefined(parameters[Parameters.DownholeLocation.BOTTOMMEASUREDDEPTH]):
                raise ValueError( "Distributed completion requires both TopMeasuredDepth and BottomMeasuredDepth input parameters. Please specify them in parameters dictionary.")
            bottom_measured_depth = parameters[Parameters.DownholeLocation.BOTTOMMEASUREDDEPTH]
            casingSection = _find_tubing_section_at_top_bottom_depth(casingSections, top_measured_depth, bottom_measured_depth)
        else:
            casingSection = _find_tubing_section_at_depth(casingSections, top_measured_depth)

        if casingSection is None:
            raise ValueError("Could not find a casing to add the completion. Add a casing at depth {}".format(top_measured_depth))

        node = _add_new_node(model, class_info, name)
        node.WellString = casing_string
        new_nodes.append(node)
        #Gravel is always there as part of the Completion.
        new_nodes.append(node.Gravel)

        # check that the IPR model is specified, set the default model if not:
        if Parameters.Completion.IPRMODEL not in parameters:
            # the default is IPRPIModel
            parameters[Parameters.Completion.IPRModel] = ModelClasses.IPRPIMODEL

        locationNode = _add_downhole_location_node(model)
        locationNode.TopMeasuredDepth = top_measured_depth
        if isDistributedCompletion:
            bottom_measured_depth = parameters[Parameters.DownholeLocation.BOTTOMMEASUREDDEPTH]
            locationNode.BottomMeasuredDepth = bottom_measured_depth

        node.Location = locationNode
        new_nodes.append(locationNode)

    elif component == ModelComponents.CHOKE or \
         component == ModelComponents.SINGLEPHASESEPARATOR or \
         component == ModelComponents.SUBSURFACESAFETYVALVE or \
         component == ModelComponents.TUBINGPLUG or \
         component == ModelComponents.ENGINEKEYWORDS or \
         component == ModelComponents.GASLIFTINJECTION or \
         component == ModelComponents.ESP or \
         component == ModelComponents.PCP or \
         component == ModelComponents.RODPUMP or \
         component == ModelComponents.INJECTOR or \
         component == ModelComponents.SLIDINGSLEEVE or \
         component == ModelComponents.FLOWCONTROLVALVE or \
         component == ModelComponents.SPOTREPORT:
        # find the tubing section at the given depth to attach the equipment
        tubingSection = _find_tubing_section_at_depth(tubingSections, top_measured_depth)
        if tubingSection is None:
           raise ValueError("Could not find a tubing at {depth} to add the {equip}.".format(equip=component, depth=top_measured_depth))
        class_info = lookup_class_information_for_model_component(component, True)
        node = _add_new_node(model, class_info, name)
        node.WellString = tubing_string

        if component == ModelComponents.FLOWCONTROLVALVE:
            (is_advancewell,message) = _check_welltype_isadvanced(tubing_string)
            if not is_advancewell:
                raise ValueError(message)

        if component == ModelComponents.CHOKE or component == ModelComponents.ENGINEKEYWORDS or component == ModelComponents.INJECTOR or component == ModelComponents.SPOTREPORT:
           node.Network = None

        locationNode = _add_downhole_location_node(model)
        locationNode.TopMeasuredDepth = top_measured_depth
        node.Location = locationNode
        new_nodes.extend([node,locationNode])

    if len(new_nodes) == 0:
        raise ValueError("Downhole component {param} is not supported".format(param=component))

    # Add the Motor and cable catalog nodes
    if component == ModelComponents.ESP:
        _add_esp_motor_and_cable_nodes(model, node, new_nodes)

    if component == ModelComponents.FLOWCONTROLVALVE and _need_load_valveCatalog(parameters):
        _add_fcv_catalog_nodes(model, node, new_nodes)

    _update_catalog(model, new_nodes)

    #Special handling for setting the motor coefficient values
    if component == ModelComponents.ESP:
        context = model._catalog.lookup_context_by_node(node)
        model._set_esp_motor_coefficients(context, parameters)

    _set_node_parameters(model, node, parameters)

    if component == ModelComponents.ESP or component == ModelComponents.PCP or (component == ModelComponents.FLOWCONTROLVALVE and _need_load_valveCatalog(parameters)):
        _load_catalog_data(model, node, parameters)

    #VOGEL has to be ISOCHRONAL.
    if component == ModelComponents.COMPLETION and Parameters.Completion.IPRMODEL in parameters and context is not None and name is not None:
        if parameters["IPRModel"] == Constants.IPRModels.IPRVOGEL:
                localcontext = context+":" + name
                model.set_value(context=localcontext, parameter=Parameters.FluidLink.COMPLETIONTESTTYPE, value=Constants.CompletionTestType.ISOCHRONAL)

def _need_load_valveCatalog(parameters: Optional[Dict[str, object]]):
        return (Parameters.FlowControlValve.USEGENERICMODE in parameters) and \
            (parameters[Parameters.FlowControlValve.USEGENERICMODE] == False) and \
            (Parameters.FlowControlValve.ValveCatalogData.MANUFACTURER in parameters) and \
            (Parameters.FlowControlValve.ValveCatalogData.MODEL in parameters)

def _add_esp_motor_and_cable_nodes(model, esp_node, new_nodes):
    new_nodes.extend([esp_node.ESPMotorCatalogData, esp_node.CableCatalogData])
    #Find the ESPMotorCoefficients for the motor
    query1 = Query(model._session)
    parentFilter = defaultdict(dict)
    motor_id = _get_link_id(esp_node.ESPMotorCatalogData.id)
    parentFilter["ESPMotorCatalogData/@id"] = motor_id
    motor_coefficients = query1.filter(cls_type=model.api.ESPMotorCoefficient.cls_type_id, **parentFilter).fetch()
    new_nodes.extend(motor_coefficients.members)

def _add_fcv_catalog_nodes(model, fcv_node, new_nodes):
    new_nodes.extend([fcv_node.ValveCatalogData])
    query1 = Query(model._session)
    parentFilter = defaultdict(dict)
    valveCatalogData_id = _get_link_id(fcv_node.ValveCatalogData.id)
    parentFilter["ValveCatalogData/@id"] = valveCatalogData_id
    valve_coefficients = query1.filter(cls_type=model.api.ValveCoefficient.cls_type_id, **parentFilter).fetch()
    new_nodes.extend(valve_coefficients.members)

